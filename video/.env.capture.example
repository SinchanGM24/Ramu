# Aplikasi utama dan backend utama. Jangan gunakan NEXT_PUBLIC_DEMO_MODE=true.
RAMU_VIDEO_SOURCE=main
RAMU_VIDEO_BASE_URL=http://localhost:3001
RAMU_VIDEO_API_URL=http://localhost:4001
RAMU_VIDEO_SCHOOL_ID=

# Minimal akun Admin Sekolah pada tenant yang telah Anda setujui.
RAMU_VIDEO_ADMIN_EMAIL=
RAMU_VIDEO_ADMIN_PASSWORD=
# Opsional: diperlukan agar visual review/assessment memakai role asli.
RAMU_VIDEO_TEACHER_EMAIL=
RAMU_VIDEO_TEACHER_PASSWORD=
RAMU_VIDEO_PRINCIPAL_EMAIL=
RAMU_VIDEO_PRINCIPAL_PASSWORD=

# Pilih satu raport nyata yang boleh direkam. Jangan memakai ID contoh/demo.
RAMU_VIDEO_REPORT_ID=
# Raport PUBLISHED untuk adegan pengiriman. Bila kosong, gunakan REPORT_ID.
RAMU_VIDEO_DELIVERY_REPORT_ID=
# URL wali dan PIN khusus untuk video. Keduanya tidak dicatat ke artefak atau log.
RAMU_VIDEO_PARENT_URL=
RAMU_VIDEO_PARENT_PIN=

# Default aman: jangan set. Bila benar-benar diset true, hanya satu nilai indikator
# pada RAMU_VIDEO_REPORT_ID yang diubah melalui UI dan harus diperiksa terlebih dahulu.
# RAMU_VIDEO_ALLOW_WRITE=true

# Opsional untuk render/validasi bila FFmpeg tidak ada pada PATH.
# RAMU_VIDEO_FFMPEG=C:\\path\\to\\ffmpeg.exe
