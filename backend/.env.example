NODE_ENV=development
PORT=4001
# Satu atau beberapa origin frontend eksplisit, dipisahkan koma. Jangan gunakan *.
FRONTEND_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://ramu_app:ramu_app_local_password@localhost:15432/ramu
# Batas koneksi dan waktu tunggu PostgreSQL. Naikkan bertahap sesuai kapasitas database.
DATABASE_POOL_MAX=12
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_SLOW_TRANSACTION_MS=1000
# Maksimal upload yang diproses bersamaan dalam satu proses API.
UPLOAD_CONCURRENCY_LIMIT=8
UPLOAD_CONCURRENCY_PER_SCHOOL_LIMIT=3
# Hanya untuk menjalankan migrasi; jangan digunakan oleh API saat runtime.
DATABASE_MIGRATION_URL=postgresql://ramu:ramu_local_password@localhost:15432/ramu
# Hanya untuk seed development; jangan digunakan oleh API saat runtime.
DATABASE_SEED_URL=postgresql://ramu:ramu_local_password@localhost:15432/ramu
SESSION_COOKIE_NAME=ramu_session
# Cookie terpisah khusus /platform. Jangan samakan dengan sesi sekolah.
PLATFORM_SESSION_COOKIE_NAME=ramu_platform_session
SESSION_TTL_DAYS=7
# Sesi kedaluwarsa dihapus segera; sesi yang sudah dicabut disimpan selama nilai ini.
SESSION_RETENTION_DAYS=30
# Opsional. Audit tidak pernah dihapus otomatis sebelum kebijakan retensi sekolah ditetapkan.
# AUDIT_RETENTION_DAYS=730
RETENTION_CLEANUP_INTERVAL_MINUTES=60
# Opsional pada development satu API. Wajib bila API dijalankan lebih dari satu instance,
# agar login dan PIN wali memakai batas bersama yang atomik.
RATE_LIMIT_REDIS_URL=redis://localhost:6380
# Wajib di produksi untuk mengenkripsi tautan dan PIN wali yang dapat dibuka ulang.
PARENT_ACCESS_CREDENTIAL_KEY=ganti-dengan-rahasia-panjang-yang-unik
# Hanya untuk seed development; konfigurasi ini tidak dipakai oleh API runtime.
SEED_DEMO_PASSWORD=pass1234
SEED_SCHOOL_NAME=TK Contoh Ceria
# Hanya dipakai sekali oleh `npm run platform:bootstrap`, lalu hapus dari
# environment. PLATFORM_BOOTSTRAP_CONFIRM harus sama dengan secret di atas.
# PLATFORM_BOOTSTRAP_SECRET=ganti-dengan-secret-bootstrap-yang-panjang
# PLATFORM_BOOTSTRAP_CONFIRM=ganti-dengan-secret-bootstrap-yang-panjang
# PLATFORM_SUPER_ADMIN_NAME=Nama Pemilik RAMU
# PLATFORM_SUPER_ADMIN_EMAIL=pemilik@example.com
# PLATFORM_SUPER_ADMIN_PASSWORD=kata-sandi-awal-minimal-12-karakter
# Nilai MinIO berikut hanya untuk development lokal. Production wajib memakai
# bucket, region, access key, dan secret key yang eksplisit serta bukan kredensial lokal.
OBJECT_STORAGE_ENDPOINT=http://localhost:9010
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=ramu-private
OBJECT_STORAGE_ACCESS_KEY=ramu_minio
OBJECT_STORAGE_SECRET_KEY=ramu_minio_password
